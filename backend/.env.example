GITHUB_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Override with development only for local use. Other environments require recruiter authentication.
APP_ENV=production
# Comma-separated frontend URLs allowed to call the API (add your Vercel URL when deploying)
FRONTEND_ORIGINS=http://localhost:5173
# Comma-separated IPs of trusted reverse proxies; only then is X-Forwarded-For used.
TRUSTED_PROXY_IPS=
# Required outside local development.
RECRUITER_KEY=
